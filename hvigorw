#!/usr/bin/env bash
# TASK-M0-01 工程 wrapper：转发到 DevEco Studio 官方 hvigor wrapper。
# 官方 hvigorw.js 依赖自身位置推导 hvigor 主包路径，必须在其安装目录运行，
# 因此这里不复制官方脚本，只做定位与转发。
set -u

DEVECO_HVIGOR_WRAPPER=""
if [ -n "${DEVECO_STUDIO_PATH:-}" ] && [ -f "${DEVECO_STUDIO_PATH}/tools/hvigor/bin/hvigorw.js" ]; then
  DEVECO_HVIGOR_WRAPPER="${DEVECO_STUDIO_PATH}/tools/hvigor/bin/hvigorw.js"
fi
if [ -z "${DEVECO_HVIGOR_WRAPPER}" ] && [ -f "C:/Program Files/Huawei/DevEco Studio/tools/hvigor/bin/hvigorw.js" ]; then
  DEVECO_HVIGOR_WRAPPER="C:/Program Files/Huawei/DevEco Studio/tools/hvigor/bin/hvigorw.js"
fi
if [ -z "${DEVECO_HVIGOR_WRAPPER}" ]; then
  echo "ERROR: DevEco Studio hvigor wrapper not found." >&2
  echo "Set DEVECO_STUDIO_PATH to the DevEco Studio install dir, or install to the default location." >&2
  exit 1
fi

exec node "${DEVECO_HVIGOR_WRAPPER}" "$@"